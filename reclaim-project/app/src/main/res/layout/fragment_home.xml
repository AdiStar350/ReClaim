<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_32">

            <!-- Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_header"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/screen_padding_top"
                android:paddingBottom="@dimen/screen_padding_bottom"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:paddingStart="@dimen/screen_padding_horizontal">

                <!-- Orb -->
                <View
                    android:layout_width="@dimen/space_150"
                    android:layout_height="@dimen/space_150"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/space_neg_45"
                    android:layout_marginTop="@dimen/space_neg_45"
                    android:layout_marginBottom="@dimen/space_neg_60"
                    android:background="@drawable/bg_header_orb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_greeting"
                            android:textAppearance="@style/TextAppearance.ReClaim.DashboardTitle"
                            tools:text="Hello, Alex" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_dashboard_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="@string/dashboard_subtitle"
                            android:textAppearance="@style/TextAppearance.ReClaim.HeroSubtitle" />
                    </LinearLayout>

                    <!-- Avatar -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/space_82"
                        android:layout_height="@dimen/space_82"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginEnd="@dimen/space_neg_10"
                        android:layout_marginTop="@dimen/space_neg_10"
                        android:layout_marginBottom="@dimen/space_neg_10"
                        app:cardBackgroundColor="#28F7F5F0"
                        app:cardCornerRadius="@dimen/space_41"
                        app:cardElevation="0dp"
                        app:strokeColor="#40F7F5F0"
                        app:strokeWidth="@dimen/space_1_5">

                        <ImageView
                            android:id="@+id/image_home_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_title"
                            android:padding="@dimen/space_12"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_settings_person"
                            app:tint="@color/brand_white" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </FrameLayout>

            <!-- Claim decision. Shown until you confirm. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_claim_decision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brand_dark"
                app:cardCornerRadius="@dimen/space_18"
                app:cardElevation="@dimen/space_4"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/space_44"
                        android:layout_height="@dimen/space_44"
                        app:cardBackgroundColor="#33FFFFFF"
                        app:cardCornerRadius="@dimen/space_22"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_10"
                            android:src="@drawable/ic_settings_claims"
                            app:tint="@color/brand_cream" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_claim_decision_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_claim_decision_title_approved"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/brand_cream"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_claim_decision_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/home_claim_decision_subtitle"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/brand_cream" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/space_20"
                        android:layout_height="@dimen/space_20"
                        android:contentDescription="@string/cd_navigate"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/brand_cream" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Private found report aimed at this user's lost item. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_targeted_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brand_accent"
                app:cardCornerRadius="@dimen/space_18"
                app:cardElevation="@dimen/space_4"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/space_44"
                        android:layout_height="@dimen/space_44"
                        app:cardBackgroundColor="#33FFFFFF"
                        app:cardCornerRadius="@dimen/space_22"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_10"
                            android:src="@drawable/ic_settings_claims"
                            app:tint="@color/text_on_accent" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_targeted_found_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/text_on_accent"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_targeted_found_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/home_targeted_found_title"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_on_accent" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/space_20"
                        android:layout_height="@dimen/space_20"
                        android:contentDescription="@string/cd_navigate"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_on_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pending claims. Shown when there are some. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pending_claims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest"
                app:cardCornerRadius="@dimen/space_18"
                app:cardElevation="@dimen/space_2"
                app:strokeColor="@color/brand_accent"
                app:strokeWidth="@dimen/space_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/space_44"
                        android:layout_height="@dimen/space_44"
                        app:cardBackgroundColor="@color/md_theme_primaryContainer"
                        app:cardCornerRadius="@dimen/space_22"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_11"
                            android:src="@drawable/ic_settings_claims"
                            app:tint="@color/brand_dark" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_review_pending_claims"
                            android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_pending_claims_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary"
                            tools:text="2 awaiting your review" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/space_20"
                        android:layout_height="@dimen/space_20"
                        android:contentDescription="@string/cd_navigate"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nearby -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_margin="@dimen/space_24">

                <View
                    android:layout_width="@dimen/space_4"
                    android:layout_height="@dimen/space_22"
                    android:background="@color/brand_accent"
                    android:backgroundTint="@color/brand_accent" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/home_nearby_title"
                    android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/home_nearby_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />

            <!--
                No horizontal padding. The fade sits at the view edge.
                Gutters come from an ItemDecoration in HomeFragment.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_nearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@color/md_theme_background"
                android:clipToPadding="false"
                android:fadingEdgeLength="@dimen/space_48"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:requiresFadingEdge="horizontal"
                tools:itemCount="4"
                tools:listitem="@layout/item_card_preview" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_nearby_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:gravity="center"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16"
                android:text="@string/home_nearby_empty"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_more"
                style="@style/Widget.ReClaim.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_14"
                android:layout_marginStart="@dimen/space_24"
                android:layout_marginEnd="@dimen/space_24"
                android:text="@string/btn_show_more"
                android:visibility="visible" />

            <!-- Possible matches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_margin="@dimen/space_24">

                <View
                    android:layout_width="@dimen/space_4"
                    android:layout_height="@dimen/space_22"
                    android:background="@color/brand_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_matches_title"
                        android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/home_matches_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:orientation="vertical" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_matches_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:gravity="center"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16"
                android:text="@string/home_matches_empty"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_32"
                android:indeterminateTint="@color/brand_accent"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
