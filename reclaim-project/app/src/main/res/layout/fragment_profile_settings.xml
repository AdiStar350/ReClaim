<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard_header"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="@dimen/screen_padding_bottom"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingStart="@dimen/screen_padding_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/text_greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_settings_title"
                        android:textAppearance="@style/TextAppearance.ReClaim.DashboardTitle" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/space_32">

            <!-- Profile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                style="@style/Widget.ReClaim.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/space_12"
                    android:paddingBottom="@dimen/space_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/space_52"
                        android:layout_height="@dimen/space_52"
                        app:cardBackgroundColor="@color/md_theme_primaryContainer"
                        app:cardCornerRadius="@dimen/space_26"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/image_settings_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_profile_avatar"
                            android:padding="@dimen/space_12"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_settings_person"
                            app:tint="@color/brand_dark" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_user_display_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle"
                            tools:text="Alex Morgan" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_user_display_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.ReClaim.BodySecondary"
                            tools:text="alex@example.com" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/space_20"
                        android:layout_height="@dimen/space_20"
                        android:contentDescription="@string/cd_navigate"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_12">

                <View
                    android:layout_width="@dimen/space_4"
                    android:layout_height="@dimen/space_22"
                    android:background="@color/brand_accent"
                    android:backgroundTint="@color/brand_accent" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/profile_section_account"
                    android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle" />
            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ReClaim.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_report_history"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_56"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_12">

                        <ImageView
                            android:layout_width="@dimen/space_22"
                            android:layout_height="@dimen/space_22"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings_history"
                            app:tint="@color/text_primary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:text="@string/settings_report_history"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/text_primary" />

                        <ImageView
                            android:layout_width="@dimen/space_20"
                            android:layout_height="@dimen/space_20"
                            android:contentDescription="@string/cd_navigate"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_12">

                <View
                    android:layout_width="@dimen/space_4"
                    android:layout_height="@dimen/space_22"
                    android:background="@color/brand_accent"
                    android:backgroundTint="@color/brand_accent" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/settings_section_preferences"
                    android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle" />
            </LinearLayout>

            <!-- Notifications -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ReClaim.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/row_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_56"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_12">

                    <ImageView
                        android:layout_width="@dimen/space_22"
                        android:layout_height="@dimen/space_22"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings_notifications"
                        app:tint="@color/text_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/settings_notifications"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:layout_width="@dimen/space_20"
                        android:layout_height="@dimen/space_20"
                        android:contentDescription="@string/cd_navigate"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Password -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ReClaim.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:id="@+id/row_password_update"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_56"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_12">

                    <ImageView
                        android:layout_width="@dimen/space_22"
                        android:layout_height="@dimen/space_22"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings_password"
                        app:tint="@color/text_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/settings_password_update"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:layout_width="@dimen/space_20"
                        android:layout_height="@dimen/space_20"
                        android:contentDescription="@string/cd_navigate"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Other -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_12">

                <View
                    android:layout_width="@dimen/space_4"
                    android:layout_height="@dimen/space_22"
                    android:background="@color/brand_accent"
                    android:backgroundTint="@color/brand_accent" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/settings_section_other"
                    android:textAppearance="@style/TextAppearance.ReClaim.SectionTitle" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ReClaim.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_logout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_56"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_12">

                        <ImageView
                            android:layout_width="@dimen/space_22"
                            android:layout_height="@dimen/space_22"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings_logout"
                            app:tint="@color/text_primary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:text="@string/btn_logout"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/text_primary" />

                        <ImageView
                            android:layout_width="@dimen/space_20"
                            android:layout_height="@dimen/space_20"
                            android:contentDescription="@string/cd_navigate"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_hint" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_54"
                        app:dividerColor="@color/md_theme_outlineVariant" />

                    <LinearLayout
                        android:id="@+id/row_delete_account"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_56"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_12">

                        <ImageView
                            android:layout_width="@dimen/space_22"
                            android:layout_height="@dimen/space_22"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings_delete"
                            app:tint="@color/type_lost" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:text="@string/btn_delete_account"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/type_lost" />

                        <ImageView
                            android:layout_width="@dimen/space_20"
                            android:layout_height="@dimen/space_20"
                            android:contentDescription="@string/cd_navigate"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/type_lost" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_hint" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_12"
                android:indeterminateTint="@color/brand_accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
